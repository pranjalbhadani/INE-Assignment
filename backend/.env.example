# Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (Session mode, port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ocshvyfuolkymliquygz.supabase.co:5432/postgres

# ── Supabase (REST client, optional for future use) ──────────────────────────
SUPABASE_URL=https://ocshvyfuolkymliquygz.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin — only this origin is allowed
FRONTEND_ORIGIN=http://localhost:5173

# ── Cron Authentication ───────────────────────────────────────────────────────
# Sent as X-Cron-Secret header from the cron provider (e.g. cron-job.org)
# Generate a strong random value: openssl rand -hex 32
CRON_SECRET=replace-with-a-strong-random-secret

# ── Scrape Concurrency Lock ───────────────────────────────────────────────────
# How long the PostgreSQL scrape lock stays valid (milliseconds).
# Must be STRICTLY GREATER than SCRAPE_TIMEOUT_MS.
# Default: 15 minutes (900000 ms)
SCRAPE_LOCK_TTL_MS=900000

# ── Scrape Execution Timeout ──────────────────────────────────────────────────
# Maximum wall-clock time allowed for a complete scrape run per product,
# including all retries and backoff delays (milliseconds).
# Must be STRICTLY LESS than SCRAPE_LOCK_TTL_MS.
# Default: 10 minutes (600000 ms) → 900000 > 600000 ✓
SCRAPE_TIMEOUT_MS=600000
